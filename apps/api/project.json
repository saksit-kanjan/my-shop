{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx watch --env-file-if-exists=.env --tsconfig apps/api/tsconfig.app.json apps/api/src/main.ts", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.app.json --noEmit", "cwd": "{workspaceRoot}" }
    }
  }
}
