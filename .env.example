# PostgreSQL for the API (required). The tables are created and upgraded by TypeORM migrations at start.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/myshop
# Keys the employee-code hashes. Generate once and never change it: changing it locks every cashier out.
CODE_SECRET=
# pg_dump for the daily backup, when it is not on PATH.
PG_DUMP_PATH=
PORT=3000
# First run on a real server: creates the owner. SEED_DEMO=0 turns the demo catalog off.
SEED_DEMO=0
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_CODE=

# --- Docker Compose (docker compose up -d --build) ---
# Password of the bundled PostgreSQL. Letters and digits only: it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
